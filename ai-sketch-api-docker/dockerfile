# Use a lightweight official Python image
FROM python:3.11-slim

# Create a non-root user for security best practices
RUN useradd -m appuser

# Set the working directory inside the container
WORKDIR /app

# Copy requirements first to leverage Docker's caching mechanism
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# Change ownership of the files to our secure user
RUN chown -R appuser:appuser /app

# Switch away from root to the secure user
USER appuser

# Document that this container listens on port 8000
EXPOSE 8000

# The command to start the web server when the container launches
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]